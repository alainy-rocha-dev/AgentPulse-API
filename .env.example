# Copy to .env (`cp .env.example .env`) and fill in ONE key to use a real LLM.
# Without a key, the worker uses a built-in stub that always returns valid JSON.
# docker-compose reads this file automatically; never commit .env.

GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: override the provider's default model
# (Groq: openai/gpt-oss-120b, OpenAI: gpt-4o-mini)
AGENTPULSE_LLM_MODEL=
